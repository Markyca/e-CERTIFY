# e-CERTIFY: production settings for the barangay computer (offline).
# setup-barangay-pc.bat copies this to ..\.env the first time it runs.
# Edit DB_PASSWORD to match the password you created for the "ecertify" MySQL user.

APP_NAME=e-CERTIFY
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://ecertify.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_certify
DB_USERNAME=ecertify
DB_PASSWORD=CHANGE_THIS_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" means nothing extra has to be running in the background
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mail is not used (the barangay computer is offline)
MAIL_MAILER=log
